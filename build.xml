<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project default="build" name="Create Runnable Jar for Project JRegr">
  <!--This ANT file should be used to manually compile and package
      Jregr as a jar. ANT 1.7 is required.

      'ant' compiles, runs the tests, and packages the jar. 'ant release'
      does the same from a clean tree and reports the version it built.
      'create_run_jar' packages without testing, and is only there for
      when you deliberately want that. -->

  <!-- Which tests 'test' runs. Override to narrow while working, e.g.
       ant test -Dtests=**/AcceptanceScenarios.java -->
  <property name="tests" value="**/*Test.java,**/Acceptance*Scenarios.java" />

  <!-- Which JDK runs the tests. RegrDirectoryRecursionTest mocks
       java.lang.Runtime, which Mockito 3 cannot do once it is final, as it
       is from JDK 26. Homebrew's ant depends on openjdk and so forks 26 no
       matter which java is on PATH, which is how a green hand-run and a red
       'ant test' came to disagree. Override the whole thing with
       -Dtest.jdk=/path/to/jdk-home, or just the version with
       -Dtest.jdk.version=N. -->
  <property name="test.jdk.version" value="21" />

  <!-- Only the libraries. Globbing '.' would put jregr.jar itself on the
       compile classpath, where a stale jar can mask a class that has been
       deleted from src. The -sources jars are excluded so javac cannot
       quietly compile against a packaged copy of someone else's sources. -->
  <path id="classpath">
    <fileset dir="lib" includes="**/*.jar"
             excludes="**/*-sources.jar,**/*-javadoc.jar,**/*-tests.jar,**/*-test-sources.jar" />
  </path>

  <!-- The tests need Jregr itself, plus junit and mockito. The same
       -sources/-javadoc/-tests exclusions apply here, or batchtest picks up
       the test classes packaged inside junit's own jar. -->
  <path id="test.classpath">
    <pathelement location="bin" />
    <pathelement location="test-bin" />
    <fileset dir="lib" includes="**/*.jar"
             excludes="**/*-sources.jar,**/*-javadoc.jar,**/*-tests.jar,**/*-test-sources.jar" />
  </path>

  <target name="clean" description="Remove all build products">
    <delete dir="bin" />
    <delete dir="test-bin" />
    <delete file="jregr.jar" />
  </target>

  <!-- bin and test-bin are emptied before each build rather than left to
       javac's up-to-date check, which compares mtimes. A fresh checkout can
       have sources older than the classes of an earlier build, and javac
       would then silently jar up and test the old code. -->
  <target name="compile">
    <delete dir="bin" />
    <mkdir dir="bin" />
    <javac includeantruntime="false" srcdir="src" destdir="bin" classpathref="classpath" target="1.8" source="1.8" />
  </target>

  <target name="compile-tests" depends="compile" description="Compile the unit and acceptance tests">
    <delete dir="test-bin" />
    <mkdir dir="test-bin" />
    <javac includeantruntime="false" destdir="test-bin" classpathref="test.classpath"
           target="1.8" source="1.8" nowarn="true">
      <src path="unit" />
      <src path="acceptance" />
    </javac>
  </target>

  <target name="-locate-test-jdk" unless="test.jdk">
    <!-- macOS ships java_home. Anywhere else this quietly does nothing and
         the tests run on ant's own JVM, so pass -Dtest.jdk there if the
         distinction matters. -->
    <exec executable="/usr/libexec/java_home" outputproperty="located.test.jdk"
          resultproperty="located.test.jdk.result" failifexecutionfails="false">
      <arg value="-v" />
      <arg value="${test.jdk.version}" />
    </exec>
    <condition property="test.jdk" value="${located.test.jdk}">
      <equals arg1="${located.test.jdk.result}" arg2="0" />
    </condition>
  </target>

  <target name="-test-jvm" depends="-locate-test-jdk">
    <condition property="test.jvm" value="${test.jdk}/bin/java" else="java">
      <isset property="test.jdk" />
    </condition>
    <echo message="Running the tests on ${test.jvm}" />
  </target>

  <target name="test" depends="compile-tests,-test-jvm" description="Run the unit and acceptance tests">
    <!-- Forked with dir set to the project root because the acceptance
         tests run Jregr as a subprocess and address both it and their
         own fixtures by relative path ('bin', 'acceptance/...'). -->
    <junit fork="true" jvm="${test.jvm}" dir="${basedir}" printsummary="true"
           haltonfailure="false" failureproperty="tests.failed">
      <classpath refid="test.classpath" />
      <formatter type="brief" usefile="false" />
      <batchtest>
        <fileset dir="unit" includes="${tests}" />
        <fileset dir="acceptance" includes="${tests}" />
      </batchtest>
    </junit>
    <fail if="tests.failed" message="There were test failures." />
  </target>

  <target name="build" depends="test,create_run_jar"
          description="Compile, run the tests, then package the jar. The default.">
  </target>

  <target name="release" depends="clean,build"
          description="Build a releasable jregr.jar: clean tree, then tests, then package">
    <!-- The one command that produces a jar worth shipping: 'build' from a
         clean tree, then say which version came out of it. -->
    <java jar="${basedir}/jregr.jar" fork="true" failonerror="true">
      <arg value="-version" />
    </java>
    <echo message="Built ${basedir}/jregr.jar. It is gitignored here, so releasing it means copying it to wherever it is consumed." />
  </target>

  <target name="create_run_jar" depends="compile">
    <jar destfile="./jregr.jar">
      <manifest>
        <attribute name="Built-By" value="${user.name}"/>
        <attribute name="Main-Class" value="se.alanif.jregr.Main"/>
        <attribute name="Class-Path" value="."/>
      </manifest>
      <fileset dir="./bin"/>
      <zipfileset excludes="META-INF/*.SF" src="./lib/commons-cli-1.4/commons-cli-1.4.jar"/>
    </jar>
  </target>
</project>
